# ─────────────────────────────────────────────────────────────────────────────
# OpenMail CF — configuration. Copiez ce fichier en .env puis lancez : npm run deploy
# Le fichier .env n'est jamais versionné ni inclus dans le code déployé.
# ─────────────────────────────────────────────────────────────────────────────

# ── Obligatoire ──────────────────────────────────────────────────────────────

# Token API Cloudflare (permissions détaillées dans le README, section « Créer le token »)
CLOUDFLARE_API_TOKEN=

# Domaine d'envoi et de réception, déjà ajouté à Cloudflare. Un seul domaine par instance :
# pour un autre domaine, déployez une autre instance avec un PROJECT_NAME différent.
MAIL_DOMAIN=example.com

# Mot de passe d'installation : demandé une seule fois sur /setup pour créer le compte administrateur
APP_PASSWORD=

# Clé de signature des sessions (32+ caractères) : openssl rand -hex 32
SESSION_SECRET=

# ── Optionnel ────────────────────────────────────────────────────────────────

# Adresse de l'app (défaut : mail.<MAIL_DOMAIN>). Ce sous-domaine ne doit pas déjà exister dans le DNS.
# APP_HOSTNAME=mail.example.com

# Préfixe des ressources Cloudflare (Workers, base D1, bucket R2, KV). Défaut : openmail-cf
# Changez-le pour déployer plusieurs instances sur le même compte.
# PROJECT_NAME=openmail-cf

# À préciser seulement si le token a accès à plusieurs comptes
# CLOUDFLARE_ACCOUNT_ID=

# Token plus restreint utilisé par l'app en production (envoi, routage, statistiques) au lieu de
# CLOUDFLARE_API_TOKEN, qui sert alors uniquement au déploiement. Recommandé : voir README.
# CLOUDFLARE_RUNTIME_TOKEN=

# Tokens séparés facultatifs (sinon le token d'exécution est utilisé)
# CLOUDFLARE_ANALYTICS_TOKEN=   # « Account Analytics : Read » — statut final Délivré / Rejeté
# CLOUDFLARE_ROUTING_TOKEN=     # « Email Routing Rules : Edit » — règles de réception

# Diriger toutes les adresses inconnues du domaine (catch-all) vers la boîte de réception de l'app
# CATCH_ALL=true

# Copie de chaque e-mail reçu vers une boîte perso (adresse vérifiée dans Email Routing → Destination addresses)
# FORWARD_TO=moi@gmail.com

# URL publique des logos insérés dans les e-mails (défaut : <Worker de réception>/brand)
# BRAND_ASSETS_URL=

# ── Développement local uniquement (npm run dev) ─────────────────────────────
# Rempli automatiquement en production par npm run deploy.
# CLOUDFLARE_ZONE_ID=<id de zone du domaine>
# INBOX_WORKER_URL=https://openmail-cf-inbox.<compte>.workers.dev
# INBOX_SECRET=   # valeur dans .deploy/state.json après un déploiement
