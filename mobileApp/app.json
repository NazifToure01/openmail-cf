{
  "expo": {
    "name": "OpenMail CF",
    "slug": "openmail-cf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "openmailcf",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.example.openmailcf",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.example.openmailcf",
      "adaptiveIcon": {
        "backgroundColor": "#101C3B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101C3B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "OpenMail CF utilise Face ID pour protéger l'accès à vos e-mails."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#101C3B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OpenMail CF accède à vos photos pour les insérer dans vos e-mails ou les joindre.",
          "cameraPermission": "OpenMail CF utilise l'appareil photo pour joindre une photo à vos e-mails."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
